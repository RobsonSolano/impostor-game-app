# Supabase — mesmo projeto do impostor-web (banco de TESTE).
# `EXPO_PUBLIC_` é o prefixo que o Expo injeta no bundle do cliente (equivalente
# ao `NEXT_PUBLIC_` do Next). A anon key é pública por design: quem protege o
# jogo é a RLS, não o segredo da chave.
EXPO_PUBLIC_SUPABASE_URL=https://<seu-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>
